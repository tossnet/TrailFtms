@page "/ride"
@implements IAsyncDisposable
@inject IVideoPlayer Player
@inject IFtmsTreadmill Treadmill
@inject ProgramStore Store
@inject SettingsStore Settings
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject TimeProvider Time
@inject IStringLocalizer<Strings> L

<PageTitle>@Title - TrailFtms</PageTitle>

<StopShortcut OnStop="StopAsync" />

<div class="ride">
    <div class="ride-video">
        @if (_videoId is not null)
        {
            <VideoPlayer VideoId="@_videoId" />
        }
    </div>

    @if (_program is not null)
    {
        <div class="ride-profile">
            <ProgramTimeline Program="_program" Duration="ProfileDuration" Position="_position" Window="ProfileWindow"
                             OnSeek="SeekAsync" AriaLabel="@L["InclineProfile"]" />
        </div>
    }
    else if (_recorder is { HasData: true })
    {
        <div class="ride-profile">
            <ProgramTimeline Program="RecordedProfile" Duration="ProfileDuration" Position="_position" Window="ProfileWindow"
                             AriaLabel="@L["InclineProfile"]" />
        </div>
    }

    <aside class="ride-panel">
        <div class="panel-head">
            <WinOldButton OnClick="Back">@L["Back"]</WinOldButton>
            <span class="title">@Title</span>
        </div>

        @if (_program is null)
        {
            <div class="wo-col wo-gap-8">
                <WinOldTextBox Label="@L["VideoLink"]" @bind-Value="_link" />
                <WinOldButton Default="true" OnClick="Load">@L["Load"]</WinOldButton>
            </div>
            @if (_recorder is { HasData: true } recorder)
            {
                <div class="wo-col wo-gap-8">
                    <WinOldInfoBar Icon="Icon.Information" Closable="false"
                                   Message="@(_savedRevision == recorder.Revision ? L["RecordingSaved"] : L[IsRecording ? "Recording" : "RecordingDone", recorder.Segments.Count])" />
                    @if (!IsRecording)
                    {
                        <div class="tools">
                            <WinOldButton Default="true" OnClick="DownloadRecordingAsync"><BiIcon Name="BiIconName.Download" /> @L["DownloadRecording"]</WinOldButton>
                            <WinOldButton Disabled="_savedRevision == recorder.Revision" OnClick="SaveRecordingAsync">@L["SaveAdjusted"]</WinOldButton>
                        </div>
                    }
                </div>
            }
            else if (_videoId is not null)
            {
                <WinOldInfoBar Icon="Icon.Information" Closable="false"
                               Message="@L[Treadmill.State == TreadmillState.Connected ? "RecordHint" : "RecordNeedsTreadmill"]" />
            }
        }

        @if (_error is not null)
        {
            <WinOldInfoBar Icon="Icon.Alert" Message="@_error" Closable="true" OnClose="() => _error = null" />
        }
        @if (_program is not null && Treadmill.State != TreadmillState.Connected && _engine.Status is RideStatus.Idle)
        {
            <WinOldInfoBar Icon="Icon.Information" Closable="false" Message="@L["TreadmillNotConnected"]" />
        }
        @if (_engine.Status == RideStatus.Halted)
        {
            <WinOldInfoBar Icon="Icon.Critical" Closable="false" Message="@L[$"Halt_{_engine.HaltReason}"]" />
            @if (Treadmill.State == TreadmillState.Connected)
            {
                <WinOldButton OnClick="ResumeSync">@L["ResumeSync"]</WinOldButton>
            }
        }
        @if (_warning is not null)
        {
            <WinOldInfoBar Icon="Icon.Alert" Message="@_warning" Closable="true" OnClose="() => _warning = null" />
        }
        @if (_program is not null && !_engine.IsActive && _engine.Adjustments.Count > 0)
        {
            <div class="wo-col wo-gap-8">
                <WinOldInfoBar Icon="Icon.Information" Closable="false"
                               Message="@(_adjustedSaved ? L["AdjustedSaved"] : L["RideAdjusted", _engine.Adjustments.Count])" />
                <div class="tools">
                    <WinOldButton Default="true" OnClick="DownloadAdjustedAsync"><BiIcon Name="BiIconName.Download" /> @L["DownloadAdjusted"]</WinOldButton>
                    <WinOldButton Disabled="_adjustedSaved" OnClick="SaveAdjustedAsync">@L["SaveAdjusted"]</WinOldButton>
                </div>
            </div>
        }

        <div class="metrics">
            <div class="metric">
                <span class="label">@L["Speed"]</span>
                <span class="value">@Number(_data?.SpeedKmh, "0.0")<small> km/h</small></span>
                @if (_engine.TargetSpeed is { } speed)
                {
                    <span class="target">@L["Target"] @speed.ToString("0.0")</span>
                }
            </div>
            @if (IsBike)
            {
                <div class="metric">
                    <span class="label">@L["Resistance"]</span>
                    <span class="value">@(_data?.ResistanceLevel?.ToString() ?? "-")</span>
                    @if (_engine.TargetIncline is { } incline)
                    {
                        <span class="target">@L["Target"] @DomyosProtocol.LevelFor(incline)</span>
                    }
                </div>
                <div class="metric">
                    <span class="label">@L["Cadence"]</span>
                    <span class="value">@(_data?.CadenceRpm?.ToString() ?? "-")<small> rpm</small></span>
                </div>
            }
            else
            {
                <div class="metric">
                    <span class="label">@L["Incline"]</span>
                    <span class="value">@Number(_data?.InclinePercent, "0.#")<small> %</small></span>
                    @if (_engine.TargetIncline is { } incline)
                    {
                        <span class="target">@L["Target"] @incline.ToString("0.#")</span>
                    }
                </div>
            }
            @if (_calories.Profile is not null)
            {
                <div class="metric calories">
                    <span class="label">@L["Calories"]</span>
                    <span class="value">@_calories.TotalKcal.ToString("0")<small> kcal</small></span>
                    <span class="target">@(_data?.TotalEnergyKcal is { } machine ? L["CaloriesMachine", machine] : L["CaloriesEstimated"])</span>
                </div>
            }
            else if (_data?.TotalEnergyKcal is { } machineKcal)
            {
                <div class="metric calories">
                    <span class="label">@L["Calories"]</span>
                    <span class="value">@machineKcal<small> kcal</small></span>
                    <span class="target">@L["CaloriesFromMachine"]</span>
                </div>
            }
            @if (ProfileDuration > 0)
            {
                <div class="metric remaining">
                    <span class="label">@L["Remaining"]</span>
                    <span class="value">@Formatting.Time(Math.Ceiling(ProfileDuration - _position))</span>
                </div>
            }
            @if (_engine.IsActive)
            {
                <div class="metric next">
                    <span class="label">@L["Next"]</span>
                    @if (NextSegment is { } next)
                    {
                        <span class="value"><span>@Treadmill.ClampSpeed(next.Speed * Factor).ToString("0.0")<small> km/h</small></span> @if (IsBike)
                            {
                                <span>@L["Level", DomyosProtocol.LevelFor(Treadmill.ClampIncline(next.Incline))]</span>
                            }
                            else
                            {
                                <span>@Treadmill.ClampIncline(next.Incline).ToString("0.#")<small> %</small></span>
                            }</span>
                        <span class="target">@L["NextIn", Formatting.Time(Math.Ceiling(_engine.NextChangeIn ?? 0))]</span>
                    }
                    else
                    {
                        <span class="target">@L["LastSegment"]</span>
                    }
                </div>
            }
        </div>

        @if (_program is not null)
        {
            <RouteProfile Program="_program" Duration="ProfileDuration" Position="_position" AriaLabel="@L["RouteOverview"]" />
        }

        <div class="tools">
            <WinOldButton OnClick="ToggleFullscreenAsync"><BiIcon Name="BiIconName.ArrowsFullscreen" /> @L["Fullscreen"]</WinOldButton>
            @if (Treadmill.State == TreadmillState.Connected)
            {
                <WinOldButton OnClick="Treadmill.DisconnectAsync">@L["Disconnect"]</WinOldButton>
            }
            <span class="status">@L[$"VideoState_{Player.State}"]@(_engine.Status != RideStatus.Idle ? $" - {L[$"RideStatus_{_engine.Status}"]}" : "")@(_engine.IsAdPlaying ? $" - {L["AdPlaying"]}" : "")</span>
        </div>

        <div class="stop-area">
            <WinOldButton Class="stop" OnClick="StopAsync">@L["Stop"]</WinOldButton>
        </div>
    </aside>
</div>

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromMilliseconds(250);

    // Long videos (often 30 to 50 min): the profile shows 5 min around the position and scrolls with it.
    private const double ScrollingProfileFrom = 10 * 60;
    private const double ProfileWindowSeconds = 5 * 60;

    private RideEngine _engine = null!;
    private readonly CalorieEstimator _calories = new();
    private RideProgram? _program;
    private TreadmillData? _data;
    private string? _link;
    private string? _videoId;
    private string? _error;
    private string? _warning;
    private double _position;
    private double _duration;
    private long _openedAt;
    private bool _adjustedSaved;
    private RideRecorder? _recorder;
    private int? _downloadedRevision;
    private int? _savedRevision;
    private IJSObjectReference? _ui;
    private IJSObjectReference? _files;
    private readonly CancellationTokenSource _cts = new();

    /// <summary>Video id or link, e.g. /ride?v=KiEN4HxM4ic.</summary>
    [SupplyParameterFromQuery(Name = "v")]
    public string? V { get; set; }

    /// <summary>Program id, e.g. /ride?program=blue-pools-nz.</summary>
    [SupplyParameterFromQuery(Name = "program")]
    public string? ProgramId { get; set; }

    private string Title => _program?.Title ?? L["Video"];

    private double Factor => _engine.Settings.SpeedFactor;

    /// <summary>Resistance and cadence instead of the inclination, see <see cref="MachineKind.Bike"/>.</summary>
    private bool IsBike => Treadmill.Kind == MachineKind.Bike;

    /// <summary>The estimate uses walking and running equations: on a bike, the console value is shown instead.</summary>
    private BodyProfile? CalorieProfile => IsBike ? null : Settings.Current.Body;

    private double ProfileDuration => _program?.DurationSeconds is > 0 and var d ? d : _duration;

    private double? ProfileWindow => ProfileDuration > ScrollingProfileFrom ? ProfileWindowSeconds : null;

    /// <summary>The ride recorded so far, for the profile.</summary>
    private RideProgram RecordedProfile => _recorder!.ToProgram("", Title, _videoId!);

    /// <summary>Free ride: the video plays, the recorder follows the treadmill.</summary>
    private bool IsRecording => Player.State is VideoState.Playing or VideoState.Buffering;

    private ProgramSegment? NextSegment =>
        _program is not null && _engine.SegmentIndex >= 0 && _engine.SegmentIndex + 1 < _program.Segments.Count
            ? _program.Segments[_engine.SegmentIndex + 1]
            : null;

    protected override async Task OnInitializedAsync()
    {
        _openedAt = Time.GetTimestamp();
        _engine = new RideEngine(Treadmill, Player, Time);
        _engine.Changed += OnChanged;
        _engine.WarningRaised += OnWarning;
        Player.StateChanged += OnChanged;
        Player.ErrorOccurred += OnPlayerError;
        Treadmill.DataReceived += OnData;
        Settings.Changed += OnSettingsChanged;
        _data = Treadmill.LastData;
        _ = RefreshPositionAsync(_cts.Token);

        await Settings.LoadAsync();
        _engine.Settings = Settings.Current.Ride;
        _calories.Profile = CalorieProfile;

        if (ProgramId is null)
        {
            _link = V;
            _videoId = YouTubeUrl.ParseVideoId(V);
            return;
        }

        await Store.LoadAsync();
        _program = Store.Find(ProgramId);
        if (_program is null)
        {
            _error = L["ProgramNotFound"];
            return;
        }

        _videoId = _program.YoutubeId;
        if (Treadmill.State == TreadmillState.Connected)
            _engine.Start(_program);
    }

    private void Load()
    {
        _error = null;
        var id = YouTubeUrl.ParseVideoId(_link);
        if (id is null)
        {
            _error = L["InvalidVideoLink"];
            return;
        }

        _videoId = id;
        _recorder = null;
        _downloadedRevision = _savedRevision = null;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("v", id), replace: true);
    }

    private void Back() => Navigation.NavigateTo(_program is null ? "" : "programs");

    /// <summary>STOP button and Space / Escape: always stops the belt and the video, and ends a free ride.</summary>
    private async Task StopAsync()
    {
        await _engine.StopAsync();
        if (_recorder is { HasData: true } recorder && recorder.Revision != _downloadedRevision)
            await DownloadRecordingAsync();
    }

    private void ResumeSync()
    {
        _warning = null;
        _adjustedSaved = false;
        if (_program is not null)
            _engine.Start(_program);
    }

    private Task SeekAsync(double seconds) => Player.SeekAsync(seconds);

    /// <summary>The program with the changes made on the treadmill console, same id so that it replaces the original.</summary>
    private RideProgram AdjustedProgram() => RideAdjustment.ApplyAll(_program!, _engine.Adjustments);

    private Task DownloadAdjustedAsync() => DownloadAsync(AdjustedProgram());

    private async Task DownloadAsync(RideProgram program)
    {
        _files ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/files.js");
        await _files.InvokeVoidAsync("downloadText", $"{program.Id}.json", ProgramParser.Serialize(program));
    }

    /// <summary>Free ride: the treadmill speed and incline follow the video time, beyond ads and pauses.</summary>
    private void Record()
    {
        if (_program is not null || _videoId is null || !IsRecording || Treadmill.State != TreadmillState.Connected
            || Treadmill.LastData is not { SpeedKmh: > 0 and var speed } data)
            return; // a stopped belt is not part of the ride

        _recorder ??= new RideRecorder(Treadmill.SpeedRange?.Step is > 0 and var s ? s : 0.1,
                                       Treadmill.InclineRange?.Step is > 0 and var i ? i : 1.0);
        _recorder.Observe(_position, _duration, speed, data.InclinePercent ?? 0);
    }

    /// <summary>The recorded ride, named after the video.</summary>
    private async Task<RideProgram> RecordedAsync()
    {
        var now = Time.GetLocalNow();
        var title = (await Player.GetTitleAsync()).Trim();
        if (title.Length == 0)
            title = L["RecordedRideTitle", now.ToString("d")];
        var id = ProgramDraft.Slugify(title);
        return _recorder!.ToProgram(id.Length > 0 ? id : $"course-{now:yyyyMMdd-HHmm}", title, _videoId!);
    }

    private async Task DownloadRecordingAsync()
    {
        var revision = _recorder!.Revision;
        await DownloadAsync(await RecordedAsync());
        _downloadedRevision = revision;
    }

    private async Task SaveRecordingAsync()
    {
        var revision = _recorder!.Revision;
        var result = await Store.ImportAsync(ProgramParser.Serialize(await RecordedAsync()));
        if (result.IsValid)
            _savedRevision = revision;
        else
            _error = L["InvalidProgram"];
    }

    private async Task SaveAdjustedAsync()
    {
        var result = await Store.ImportAsync(ProgramParser.Serialize(AdjustedProgram()));
        if (result.IsValid)
            _adjustedSaved = true;
        else
            _error = L["InvalidProgram"];
    }

    private async Task ToggleFullscreenAsync()
    {
        _ui ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/ui.js");
        await _ui.InvokeVoidAsync("toggleFullscreen");
    }

    private async Task RefreshPositionAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(RefreshInterval, Time);
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                if (Player.State is VideoState.NotLoaded)
                    continue;

                _position = await Player.GetCurrentTimeAsync();
                _duration = await Player.GetDurationAsync();
                Record();
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Page left.
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnData(TreadmillData data)
    {
        _data = data;
        _calories.Observe(Time.GetElapsedTime(_openedAt).TotalSeconds, data);
        InvokeAsync(StateHasChanged);
    }

    private void OnSettingsChanged()
    {
        _engine.Settings = Settings.Current.Ride;
        _calories.Profile = CalorieProfile;
        InvokeAsync(StateHasChanged);
    }

    private void OnWarning(RideWarning warning)
    {
        _warning = L[$"RideWarning_{warning}"];
        InvokeAsync(StateHasChanged);
    }

    private void OnPlayerError(VideoError error)
    {
        _error = L[$"VideoError_{error}"];
        InvokeAsync(StateHasChanged);
    }

    private static string Number(double? value, string format) => value?.ToString(format) ?? "-";

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        Player.StateChanged -= OnChanged;
        Player.ErrorOccurred -= OnPlayerError;
        Treadmill.DataReceived -= OnData;
        Settings.Changed -= OnSettingsChanged;
        _engine.Changed -= OnChanged;
        _engine.WarningRaised -= OnWarning;
        await _engine.DisposeAsync();
        foreach (var module in new[] { _ui, _files })
        {
            if (module is null)
                continue;
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
