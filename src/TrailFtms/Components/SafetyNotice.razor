@inject SettingsStore Settings
@inject IDialogService Dialogs
@inject IStringLocalizer<Strings> L

@* First launch: safety warning in a WinOld message box (rendered by the host of WinOldAppShell). *@

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await Settings.LoadAsync();
        if (Settings.SafetyAccepted)
            return;

        var accepted = await Dialogs.ShowMessageBox(new MessageBoxOptions
        {
            Appearance = Appearance.Win10,
            TouchMode = true,
            Icon = Icon.Alert,
            Title = L["SafetyTitle"],
            Message = string.Join("\n\n",
                L["SafetyIntro"], L["SafetyKey"], L["SafetyStop"], L["SafetyLimits"], L["SafetyResponsibility"]),
            OkButtonText = L["SafetyAccept"],
        });

        // Closed without "I understand": ask again next time.
        if (accepted == true)
            await Settings.AcceptSafetyAsync();
    }
}
