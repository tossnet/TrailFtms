@implements IAsyncDisposable
@inject IJSRuntime JS

@* Space / Escape anywhere on the page (even after a click in the video) calls OnStop. *@

@code {
    private IJSObjectReference? _module;
    private DotNetObjectReference<StopShortcut>? _selfRef;
    private int _id;

    [Parameter, EditorRequired]
    public EventCallback OnStop { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ui.js");
        _selfRef = DotNetObjectReference.Create(this);
        _id = await _module.InvokeAsync<int>("addStopShortcut", _selfRef);
    }

    [JSInvokable]
    public Task OnStopShortcut() => OnStop.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("removeStopShortcut", _id);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
        _selfRef?.Dispose();
    }
}
